# Copy to .dev.vars and fill in from https://discord.com/developers/applications
# (OAuth2 > Redirects: http://localhost:5173/api/auth/discord/callback)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Local dev: the callback goes through Vite (port 5173). Not needed in production.
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback
