{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ark-breeding",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // One Worker serves the API on /api/* and the static build of apps/web for everything else.
  "assets": {
    "directory": "../web/build/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // pre-rendered pages (EF-18) live in especes/<slug>/index.html: served at /especes/<slug>,
    // the address in the sitemap, without a redirect to a trailing slash
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ark-breeding",
      "database_id": "13c300f9-60b6-4f44-8c33-988a04ce2329",
      // local `wrangler dev` database, kept apart from production
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  // RSE-04: erases the accounts inactive for 3 years, every day at 04:00 UTC
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
