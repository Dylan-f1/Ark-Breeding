{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ark-breeding",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // One Worker serves the API on /api/* and the static build of apps/web for everything else.
  "assets": {
    "directory": "../web/build/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ark-breeding",
      // Replace with the id printed by `npx wrangler d1 create ark-breeding` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
