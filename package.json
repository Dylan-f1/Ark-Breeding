{
  "name": "ark-breeding",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @ark-breeding/api\" \"npm run dev -w @ark-breeding/web\"",
    "build": "npm run build -w @ark-breeding/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @ark-breeding/api",
    "db:migrate:local": "npm run db:migrate:local -w @ark-breeding/api",
    "db:migrate:remote": "npm run db:migrate:remote -w @ark-breeding/api",
    "deploy": "npm run build && npm run deploy -w @ark-breeding/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
